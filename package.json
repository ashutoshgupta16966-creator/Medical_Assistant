{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@workspace/medical-assistant",
    "build:all": "npm run typecheck && npm run build --workspaces --if-present",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && npm run typecheck --workspaces --if-present",
    "start": "npm run start --workspace=@workspace/api-server",
    "start:client": "npm run serve --workspace=@workspace/medical-assistant",
    "dev:api": "npm run dev --workspace=@workspace/api-server",
    "dev:client": "npm run dev --workspace=@workspace/medical-assistant",
    "test": "npm run test --workspace=@workspace/medical-assistant"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "esbuild-plugin-pino": {
      "esbuild": "$esbuild"
    }
  }
}
