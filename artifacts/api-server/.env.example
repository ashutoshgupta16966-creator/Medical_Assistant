# Medical Assistant API Server Environment Configuration

# Provider API Keys
# Read from process.env only. Missing keys will cause that provider's tiers to be skipped silently.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: Override the fallback chain order (comma-separated model IDs)
# AI_MODELS=claude-opus-4.8,claude-sonnet-4.6,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
